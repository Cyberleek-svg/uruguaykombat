{
  "name": "uruguay-kombat",
  "version": "1.0.0",
  "description": "Juego de pelea 2D - FA vs Derecha (Uruguay Kombat)",
  "author": "Uruguay Kombat Dev",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "phaser": "^3.80.1",
    "vite": "^5.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.uruguaykombat.app",
    "productName": "Uruguay Kombat",
    "electronLanguages": ["es", "en-US"],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}